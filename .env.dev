# Development Environment Configuration
NODE_ENV=development

# JWT Secrets (Dev only - change for production)
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-change-in-production

# Angel One API Configuration (Dev)
ANGEL_ONE_API_KEY=your-dev-angel-one-api-key
ANGEL_ONE_CLIENT_ID=your-dev-angel-one-client-id

# Database Configuration (Dev)
POSTGRES_PASSWORD=auth_password
POSTGRES_USER=auth_user
POSTGRES_DB=auth_db

# Logging Level
LOG_LEVEL=debug

# Features Flags
ENABLE_METRICS=true
ENABLE_SWAGGER=true
