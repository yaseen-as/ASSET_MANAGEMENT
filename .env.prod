# Production Environment Configuration
NODE_ENV=production

# JWT Secrets (MUST be changed for production)
JWT_SECRET=${PROD_JWT_SECRET}
JWT_REFRESH_SECRET=${PROD_JWT_REFRESH_SECRET}

# Angel One API Configuration (Production)
ANGEL_ONE_API_KEY=${PROD_ANGEL_ONE_API_KEY}
ANGEL_ONE_CLIENT_ID=${PROD_ANGEL_ONE_CLIENT_ID}

# Database Configuration (Production)
POSTGRES_PASSWORD=${PROD_POSTGRES_PASSWORD}
POSTGRES_USER=${PROD_POSTGRES_USER}

# Logging Level
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_SWAGGER=false

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000
