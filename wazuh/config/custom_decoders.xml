<!-- Custom Wazuh Decoders for Asset Management Application -->
<decoder name="asset-management-json">
  <prematch>^{"timestamp":</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="auth-service">
  <parent>asset-management-json</parent>
  <type>json</type>
  <use_own_name>true</use_own_name>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="portfolio-service">
  <parent>asset-management-json</parent>
  <type>json</type>
  <use_own_name>true</use_own_name>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="market-service">
  <parent>asset-management-json</parent>
  <type>json</type>
  <use_own_name>true</use_own_name>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="nginx-access">
  <prematch>^\d+.\d+.\d+.\d+ - </prematch>
  <regex offset="after_prematch">^(\S+) - (\S+) \[(\S+ \S+)\] "\w+ (\S+) HTTP/\d.\d" (\d+) \d+ "(\S+)" "(\S+)"</regex>
  <order>srcip,user,timestamp,url,status,referer,user_agent</order>
</decoder>

<decoder name="postgresql-log">
  <prematch>^LOG:</prematch>
  <regex>^LOG:\s+(\S+)\s+(.+)$</regex>
  <order>log_level,log_message</order>
</decoder>

<decoder name="kubernetes-event">
  <prematch>^kubernetes</prematch>
  <regex>^kubernetes\s+(\S+)\s+(\S+)\s+(.+)$</regex>
  <order>component,event_type,message</order>
</decoder>
