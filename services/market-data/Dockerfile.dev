# Development Dockerfile for Market Data Service
FROM node:18-alpine

WORKDIR /app

# Install curl for health checks and development tools
RUN apk add --no-cache curl openssl libc6-compat

# Copy package files
COPY package*.json ./

# Install all dependencies (including devDependencies)
RUN npm install

# Copy prisma schema first (needed for generate)
COPY prisma ./prisma

# Generate Prisma client with correct binary target for Alpine
RUN npx prisma generate --schema=./prisma/schema.prisma

# Create logs directory
RUN mkdir -p logs

# Copy source code (will be overridden by volume mount in dev)
COPY . .

# Expose port
EXPOSE 3003

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3003/health || exit 1

# Start application with hot reload
# CMD ["npm", "run", "dev"]
CMD ["sh", "-c", "npx prisma migrate deploy --schema=./prisma/schema.prisma && npm run dev"]

