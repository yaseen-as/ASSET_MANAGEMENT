FROM node:18-alpine

WORKDIR /app

# Install tsx for development
RUN npm install -g tsx

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (including dev)
RUN npm install

# Copy source code
COPY src/ ./src/

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S apigateway -u 1001

# Change ownership
RUN chown -R apigateway:nodejs /app
USER apigateway

EXPOSE 3000

CMD ["npm", "run", "dev"]