# Environment variables for all services
# Copy this file to .env and update with your actual values

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production

# =============================================================================
# EXTERNAL API CREDENTIALS
# =============================================================================
# Angel One API Credentials for market data
ANGEL_ONE_API_KEY=your-angel-one-api-key
ANGEL_ONE_CLIENT_ID=your-angel-one-client-id

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development databases
AUTH_DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db
PORTFOLIO_DATABASE_URL=postgresql://portfolio_user:portfolio_password@localhost:5433/portfolio_db
MARKET_DATABASE_URL=postgresql://market_user:market_password@localhost:5434/market_db

# Test databases (used during testing)
AUTH_TEST_DATABASE_URL=postgresql://auth_test:auth_test@localhost:5435/auth_test
PORTFOLIO_TEST_DATABASE_URL=postgresql://portfolio_test:portfolio_test@localhost:5436/portfolio_test
MARKET_TEST_DATABASE_URL=postgresql://market_test:market_test@localhost:5437/market_test

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Service Ports
AUTH_SERVICE_PORT=3001
PORTFOLIO_SERVICE_PORT=3002
MARKET_SERVICE_PORT=3003

# Node Environment
NODE_ENV=development

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================
# Logging Configuration
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_SWAGGER=true
ENABLE_REQUEST_LOGGING=true

# Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================
# Jenkins
JENKINS_PORT=8080

# Docker Registry (for production deployments)
DOCKER_REGISTRY=your-docker-registry-url

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# PRODUCTION SECRETS (DO NOT COMMIT THESE VALUES)
# =============================================================================
# These should be set as environment variables in production
# PROD_JWT_SECRET=your-production-jwt-secret
# PROD_JWT_REFRESH_SECRET=your-production-refresh-secret
# PROD_ANGEL_ONE_API_KEY=your-production-api-key
# PROD_ANGEL_ONE_CLIENT_ID=your-production-client-id
# PROD_POSTGRES_PASSWORD=your-production-db-password
# PROD_POSTGRES_USER=your-production-db-user

# =============================================================================
# DEVELOPMENT HELPERS
# =============================================================================
# Enable hot reload in development
DEV_HOT_RELOAD=true

# Skip SSL verification in development
NODE_TLS_REJECT_UNAUTHORIZED=0

# PGAdmin Configuration
PGADMIN_DEFAULT_EMAIL=your-pgadmin-email
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password