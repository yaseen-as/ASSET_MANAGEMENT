# Test Environment Configuration
NODE_ENV=test

# JWT Secrets (Test)
JWT_SECRET=test-jwt-secret-key
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key

# Angel One API Configuration (Test/Mock)
ANGEL_ONE_API_KEY=test-angel-one-api-key
ANGEL_ONE_CLIENT_ID=test-angel-one-client-id

# Database Configuration (Test)
DATABASE_URL_TEST=postgresql://auth_test:auth_test@auth-db-test:5432/auth_test

# Logging Level
LOG_LEVEL=error

# Feature Flags
ENABLE_METRICS=false
ENABLE_SWAGGER=false
SKIP_MIGRATIONS=true
