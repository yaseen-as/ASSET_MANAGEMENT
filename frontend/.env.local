# Frontend Environment Configuration - Development
# This file overrides .env for local development

# API Base URL - Should point to nginx proxy
VITE_REACT_APP_API_URL=http://localhost:8080

# Development mode
NODE_ENV=development
VITE_NODE_ENV=development

# Enable debug logging
VITE_DEBUG_API=true

# Disable service worker for development
VITE_SW_ENABLED=false