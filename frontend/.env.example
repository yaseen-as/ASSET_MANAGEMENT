# Environment variables for all services
# Copy this file to .env and update with your actual values

# JWT Secrets (Change these in production!)
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345678901234567890
# JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production-12345678901234567890

# # Angel One API Credentials
# ANGEL_ONE_API_KEY=qrpx1rMm
# ANGEL_ONE_CLIENT_ID=AABM966103

# # Database URLs (used in development)
# AUTH_DATABASE_URL=postgresql://auth_user:auth_password@auth-db:5432/auth_db
# PORTFOLIO_DATABASE_URL=postgresql://portfolio_user:portfolio_password@portfolio-db:5432/portfolio_db
# MARKET_DATABASE_URL=postgresql://market_user:market_password@market-db:5432/market_db

# API Base URL for frontend
VITE_REACT_APP_API_URL=http://localhost:3001

# # Service Ports
# AUTH_SERVICE_PORT=3001
# PORTFOLIO_SERVICE_PORT=3002
# MARKET_SERVICE_PORT=3003
